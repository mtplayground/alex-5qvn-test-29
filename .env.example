# PostgreSQL connection string used by the Rust server, tests, and seed binary.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/graph_playground

# The axum server bind address.
BIND_ADDR=0.0.0.0:8080

# Seed the transit demo graph during server startup.
# Set to false after the first successful load if you want startup to skip seeding.
SEED_ON_START=true
